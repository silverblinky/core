{% extends "layouts.master" %}

{% block content %}
<!-- Hero Section -->
<section class="relative min-h-[85vh] flex items-center justify-center overflow-hidden bg-[#FAF8F5] border-b border-[#1E1E1E]/5">
    <div class="max-w-6xl mx-auto px-6 py-20 grid md:grid-cols-2 gap-12 items-center w-full">
        <div class="space-y-6 text-start">
            <span class="inline-block text-[11px] font-medium tracking-[0.2em] uppercase text-[#1E1E1E]/60 bg-[#1E1E1E]/5 px-3 py-1 rounded-full">
                صُنع في السعودية
            </span>
            <h1 class="text-4xl md:text-6xl font-light leading-[1.2] tracking-tight">
                مفهوم جديد<br><span class="font-normal">لتجربة العطور</span>
            </h1>
            <p class="text-base md:text-lg text-[#1E1E1E]/70 max-w-md font-light leading-relaxed">
                عطر صلب بتركيبة شمعية طبيعية خالية من الكحول، صُمم ليرافقك في جيبك ويدوم على نبضك طوال اليوم.
            </p>
            <div class="pt-4 flex flex-wrap gap-4 items-center">
                <a href="#featured" class="px-8 py-3.5 rounded-full bg-[#1E1E1E] text-[#FAF8F5] text-sm font-medium hover:opacity-90 transition-opacity">
                    اكتشف الرائحة
                </a>
                <button @click="openQuiz()" type="button" class="px-6 py-3.5 rounded-full border border-[#1E1E1E]/20 text-[#1E1E1E] text-sm font-medium hover:border-[#1E1E1E] transition-colors">
                    اختبار الرائحة المناسبة
                </button>
            </div>
        </div>

        <div class="relative flex justify-center items-center">
            <div class="w-full max-w-md aspect-square rounded-3xl overflow-hidden bg-[#1E1E1E]/5 border border-[#1E1E1E]/10 flex items-center justify-center p-8 shadow-sm">
                <img src="{{ 'images/hero.webp'|asset }}" alt="عطر كور الصلب" class="w-full h-full object-contain filter drop-shadow-md" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1592945403244-b3fbafd7f539?auto=format&fit=crop&w=800&q=80';">
            </div>
        </div>
    </div>
</section>

<!-- Value Strip -->
<section class="border-b border-[#1E1E1E]/5 py-10 bg-white/40">
    <div class="max-w-5xl mx-auto px-6 grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div class="space-y-1">
            <p class="text-[10px] tracking-[0.15em] text-[#1E1E1E]/50 uppercase font-mono">REFILLABLE</p>
            <p class="text-sm font-medium">قابل لإعادة التعبئة</p>
        </div>
        <div class="space-y-1">
            <p class="text-[10px] tracking-[0.15em] text-[#1E1E1E]/50 uppercase font-mono">NATURAL</p>
            <p class="text-sm font-medium">مكونات طبيعية</p>
        </div>
        <div class="space-y-1">
            <p class="text-[10px] tracking-[0.15em] text-[#1E1E1E]/50 uppercase font-mono">ALCOHOL-FREE</p>
            <p class="text-sm font-medium">خالٍ من الكحول</p>
        </div>
        <div class="space-y-1">
            <p class="text-[10px] tracking-[0.15em] text-[#1E1E1E]/50 uppercase font-mono">UNISEX</p>
            <p class="text-sm font-medium">مناسب للجنسين</p>
        </div>
    </div>
</section>

<!-- Interactive Featured Product Section -->
<section id="featured" class="max-w-6xl mx-auto px-6 py-20">
    <div class="grid md:grid-cols-2 gap-12 lg:gap-16 items-start">

        <!-- Product Image Gallery -->
        <div class="sticky top-28">
            <div class="aspect-square rounded-2xl overflow-hidden bg-white border border-[#1E1E1E]/10 p-8 flex items-center justify-center shadow-sm">
                <template x-if="selectedScent">
                    <img :src="selectedScent.image" :alt="selectedScent.name" class="w-full h-full object-contain transition-all duration-300">
                </template>
            </div>
            
            <!-- Quick mood badges -->
            <div class="mt-4 flex items-center justify-between text-xs text-[#1E1E1E]/60 px-1">
                <span x-text="selectedScent ? selectedScent.mood : ''" class="font-light"></span>
                <span class="bg-[#1E1E1E]/5 px-2.5 py-1 rounded-md text-[11px] font-mono">300+ تمريرة</span>
            </div>
        </div>

        <!-- Custom Scent & Bundle Builder Controls -->
        <div class="space-y-8">
            <div>
                <p class="text-[11px] font-mono tracking-[0.2em] text-[#1E1E1E]/50 uppercase">THE ORIGINAL SOLID PERFUME</p>
                <h2 class="text-3xl md:text-4xl font-normal mt-2">العطر الصلب</h2>
                <div class="flex items-center gap-2 mt-3 text-sm text-[#1E1E1E]/80">
                    <span class="text-amber-500">★★★★★</span>
                    <span class="font-medium">4.9</span>
                    <span class="text-[#1E1E1E]/40">(128 تقييم موثق)</span>
                </div>
                <p class="text-sm text-[#1E1E1E]/70 mt-4 leading-relaxed font-light">
                    عطر صلب بتركيبة شمعية سهلة الحمل، بعبوة معدنية قابلة لإعادة التعبئة. اختر رائحتك المنفردة أو كوّن باقتك الثنائية بتوفير حصري.
                </p>
            </div>

            <!-- Single vs Duo Mode Switcher -->
            <div class="grid grid-cols-2 gap-3">
                <button type="button"
                        @click="setMode('single')"
                        :class="mode === 'single' ? 'border-[#1E1E1E] ring-1 ring-[#1E1E1E] bg-white' : 'border-[#1E1E1E]/20 hover:border-[#1E1E1E]/40 bg-transparent'"
                        class="p-4 rounded-xl border text-start transition-all">
                    <span class="block text-xs text-[#1E1E1E]/60">رائحة واحدة</span>
                    <span class="block text-xl font-medium mt-1">169 ر.س</span>
                    <span class="block text-[11px] text-[#1E1E1E]/40 mt-1">عبوة معدنية كاملة</span>
                </button>

                <button type="button"
                        @click="setMode('duo')"
                        :class="mode === 'duo' ? 'border-[#1E1E1E] ring-1 ring-[#1E1E1E] bg-white' : 'border-[#1E1E1E]/20 hover:border-[#1E1E1E]/40 bg-transparent'"
                        class="p-4 rounded-xl border text-start transition-all relative overflow-hidden">
                    <span class="absolute top-2 left-2 bg-[#1E1E1E] text-[#FAF8F5] text-[9px] px-2 py-0.5 rounded-full font-medium">وفّر 44 ر.س</span>
                    <span class="block text-xs text-[#1E1E1E]/60">باقة رائحتين</span>
                    <span class="block text-xl font-medium mt-1">204 ر.س</span>
                    <span class="block text-[11px] text-emerald-700 mt-1">✓ شحن مجاني</span>
                </button>
            </div>

            <!-- Scent Selection List -->
            <div>
                <div class="flex justify-between items-center mb-3">
                    <p class="text-sm font-medium" x-text="mode === 'single' ? 'اختر الرائحة المطلوبة:' : 'اختر رائحتين للباقة (' + duoPicks.length + '/2):'"></p>
                    <button @click="openQuiz()" type="button" class="text-xs text-[#1E1E1E]/70 underline hover:text-[#1E1E1E]">
                        محتار؟ جرّب اختبار الرائحة
                    </button>
                </div>

                <div class="space-y-3">
                    <template x-for="scent in scents" :key="scent.id">
                        <div :class="isSelected(scent.id) ? 'border-[#1E1E1E] ring-1 ring-[#1E1E1E] bg-white' : 'border-[#1E1E1E]/15 hover:border-[#1E1E1E]/40 bg-white/50'"
                             class="rounded-xl border p-4 transition-all">
                            <div class="flex items-center justify-between cursor-pointer" @click="pickScent(scent.id)">
                                <div class="flex items-center gap-4">
                                    <div :class="isSelected(scent.id) ? 'bg-[#1E1E1E] text-[#FAF8F5]' : 'border border-[#1E1E1E]/30'"
                                         class="w-5 h-5 rounded-full flex items-center justify-center text-[11px]">
                                        <span x-show="isSelected(scent.id)">✓</span>
                                    </div>
                                    <div>
                                        <p class="text-sm font-medium flex items-center gap-2">
                                            <span x-text="scent.name"></span>
                                            <span class="text-xs text-[#1E1E1E]/50 font-mono" x-text="scent.en"></span>
                                            <span x-show="scent.soldOut" class="text-[10px] bg-red-100 text-red-700 px-2 py-0.5 rounded-full">نفدت الكمية</span>
                                        </p>
                                        <p class="text-xs text-[#1E1E1E]/60 mt-0.5" x-text="scent.mood"></p>
                                    </div>
                                </div>
                                <span class="text-xs text-[#1E1E1E]/40 hover:text-[#1E1E1E]" @click.stop="toggleDesc(scent.id)">
                                    التفاصيل
                                </span>
                            </div>

                            <!-- Expandable notes -->
                            <div x-show="expandedDesc === scent.id || isSelected(scent.id)" x-collapse class="mt-3 pt-3 border-t border-[#1E1E1E]/5 text-xs text-[#1E1E1E]/70 space-y-2">
                                <p x-text="scent.desc" class="leading-relaxed"></p>
                                <div class="flex gap-4 text-[11px] text-[#1E1E1E]/60 font-mono pt-1">
                                    <span>القمة: <strong class="font-sans" x-text="scent.notes.top"></strong></span>
                                    <span>القلب: <strong class="font-sans" x-text="scent.notes.heart"></strong></span>
                                    <span>القاعدة: <strong class="font-sans" x-text="scent.notes.base"></strong></span>
                                </div>
                            </div>
                        </div>
                    </template>
                </div>
            </div>

            <!-- Checkout / Add to Cart CTA -->
            <div class="pt-4 space-y-3">
                <a :href="checkoutUrl"
                   :class="canCheckout ? 'bg-[#1E1E1E] text-[#FAF8F5] hover:opacity-90 shadow-sm cursor-pointer' : 'bg-[#1E1E1E]/20 text-[#1E1E1E]/40 pointer-events-none'"
                   class="w-full py-4 rounded-full flex items-center justify-center gap-3 text-base font-medium transition-all">
                    <span x-text="checkoutButtonText"></span>
                    <span>←</span>
                </a>
                <p class="text-center text-xs text-[#1E1E1E]/50">
                    ضمان رضا ١٤ يوماً · استبدال مجاني إذا لم تناسبك الرائحة
                </p>
            </div>

            <!-- Accordion Details -->
            <div class="border-t border-[#1E1E1E]/10 pt-6 space-y-4">
                <div class="border-b border-[#1E1E1E]/10 pb-4" x-data="{ open: false }">
                    <button @click="open = !open" class="flex justify-between items-center w-full text-start text-sm font-medium">
                        <span>طريقة الاستخدام (طقس التعطّر)</span>
                        <span x-text="open ? '−' : '+'" class="text-lg"></span>
                    </button>
                    <div x-show="open" x-collapse class="mt-3 text-xs text-[#1E1E1E]/70 space-y-2 leading-relaxed">
                        <p>١. اسحب الغطاء المعدني بانسيابية للكشف عن العطر.</p>
                        <p>٢. مرّر إصبعك برفق على سطح الشمع العطري لاكتساب الكمية المناسبة.</p>
                        <p>٣. وزّع العطر على نقاط النبض: المعصم، الرقبة، وخلف الأذن.</p>
                    </div>
                </div>

                <div class="border-b border-[#1E1E1E]/10 pb-4" x-data="{ open: false }">
                    <button @click="open = !open" class="flex justify-between items-center w-full text-start text-sm font-medium">
                        <span>المكونات والمواصفات</span>
                        <span x-text="open ? '−' : '+'" class="text-lg"></span>
                    </button>
                    <div x-show="open" x-collapse class="mt-3 text-xs text-[#1E1E1E]/70 leading-relaxed">
                        شمع نباتي طبيعي، زيوت عضوية مرطبة، وزيوت عطرية مركّزة خالية من الكحول. يدوم حتى ٣٠٠ تمريرة، ما يعادل زجاجة عطر ٥٠ مل.
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- Why Core Slider -->
<section id="why-core" class="bg-white/60 border-t border-[#1E1E1E]/5 py-20 px-6">
    <div class="max-w-6xl mx-auto space-y-12">
        <div class="max-w-xl">
            <p class="text-[11px] font-mono tracking-[0.2em] text-[#1E1E1E]/50 uppercase">WHY SOLID PERFUME</p>
            <h2 class="text-3xl md:text-4xl font-light mt-2">لماذا صممنا عطراً صلباً؟</h2>
        </div>

        <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-6">
            <div class="p-6 rounded-2xl bg-[#FAF8F5] border border-[#1E1E1E]/10 space-y-3">
                <span class="text-xs font-mono text-[#1E1E1E]/40">01</span>
                <h3 class="text-base font-medium">لا يتبخر في الهواء</h3>
                <p class="text-xs text-[#1E1E1E]/70 leading-relaxed">على عكس العطور الرذاذية التي يتطاير أغلبها في الجو، يثبت العطر الصلب على جلدك ونبضك مباشرة.</p>
            </div>
            <div class="p-6 rounded-2xl bg-[#FAF8F5] border border-[#1E1E1E]/10 space-y-3">
                <span class="text-xs font-mono text-[#1E1E1E]/40">02</span>
                <h3 class="text-base font-medium">حجم الجيب ومقاوم للكسر</h3>
                <p class="text-xs text-[#1E1E1E]/70 leading-relaxed">علبة معدنية مدمجة مصممة للاستخدام اليومي والسفر، دون خوف من التسريب أو الانكسار في حقيبتك.</p>
            </div>
            <div class="p-6 rounded-2xl bg-[#FAF8F5] border border-[#1E1E1E]/10 space-y-3">
                <span class="text-xs font-mono text-[#1E1E1E]/40">03</span>
                <h3 class="text-base font-medium">كبسولات قابلة للتغيير</h3>
                <p class="text-xs text-[#1E1E1E]/70 leading-relaxed">احتفظ بعلبتك المعدنية الأنيقة، واستبدل كبسولة العطر برائحة جديدة متى ما أردت بسهولة.</p>
            </div>
        </div>
    </div>
</section>
{% endblock %}
