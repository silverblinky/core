{
  "name": "core-saudi",
  "title": "كور | العطور الصلبة السعودية",
  "version": "1.0.0",
  "author": "Core Saudi",
  "description": "ثيم فاخر وبسيط مصمم خصيصاً لمتجر كور مع حاسبة باقة الرائحتين واختبار تحديد الرائحة التفاعلي.",
  "features": [
    "rtl",
    "responsive"
  ],
  "settings": {
    "header": {
      "title": "إعدادات الهيدر",
      "fields": {
        "show_announcement": {
          "type": "boolean",
          "label": "عرض شريط التنبيهات",
          "default": true
        },
        "announcement_text": {
          "type": "text",
          "label": "نص التنبيه",
          "default": "استخدم كود NEW25 للحصول على خصم ترحيبي"
        }
      }
    },
    "colors": {
      "title": "الألوان",
      "fields": {
        "background": {
          "type": "color",
          "label": "لون الخلفية",
          "default": "#FAF8F5"
        },
        "primary": {
          "type": "color",
          "label": "اللون الأساسي",
          "default": "#1E1E1E"
        }
      }
    }
  }
}